import sqlite3
import pandas as pd
import matplotlib.pyplot as plt

conn = sqlite3.connect("/Users/rubenmorais/Downloads/Analytical Projects /financial management (sports)/SQL/Sports_analytics.sqlite")
yoy = pd.read_sql("SELECT * FROM v_yoy", conn)
ratios = pd.read_sql("SELECT * FROM v_ratios", conn)

import pandas as pd
import matplotlib.pyplot as plt

colors = ["red", "blue", "green"]


df = pd.read_sql("SELECT club_name, season, net_debt FROM v_ratios", conn)
df_net_debt = df.pivot(index="season", columns="club_name", values="net_debt")
df_net_debt.plot(kind="line", figsize=(10, 6), marker="o", color=colors)

plt.title("Net debt of Benfica, Porto and Sporting, 2023/24 - 2025/26")
plt.xlabel("Season")
plt.ylabel("Net debt (€ million)")
plt.show()

df_1 = pd.read_sql("select club_name, season, core_result from v_ratios", conn)
df_core_result = df_1.pivot(index="season", columns="club_name", values="core_result")
